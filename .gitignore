# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Recognition runtime staged from npm, and model weights fetched at release build.
# They belong in the iOS bundle. They are not downloaded by the installed app.
/public/vendor/
/public/models/
/ios/App/App/public/
/ios/App/Pods/
/ios/App/Podfile.lock
/ios/DerivedData/
/ios/App/build/

# Signing material stays outside the repository.
*.mobileprovision
*.p12
*.cer
AuthKey_*.p8
*.ipa
